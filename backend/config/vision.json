{
  "pipeline_mode": "detect",
  "models": {
    "detect": "yolo26n.pt",
    "segment": "yolo26n-seg.pt"
  },
  "imgsz": {
    "detect": 640,
    "segment": 416
  },
  "confidence": {
    "default": 0.45,
    "per_class": {
      "person": 0.5,
      "car": 0.55,
      "truck": 0.55,
      "bird": 0.4,
      "dog": 0.45,
      "cow": 0.45,
      "horse": 0.45,
      "sheep": 0.45
    }
  },
  "coco_classes": {
    "enabled": [
      "person",
      "bicycle",
      "car",
      "motorcycle",
      "bus",
      "truck",
      "bird",
      "cat",
      "dog",
      "horse",
      "sheep",
      "cow"
    ]
  },
  "overlay": {
    "boxes": true,
    "labels": true,
    "masks": true
  },
  "benchmark": {
    "collect_metrics": true,
    "window_seconds": 30
  },
  "profiles": {
    "analog": {
      "detect": 416,
      "segment": 416
    },
    "digital": {
      "detect": 640,
      "segment": 640
    }
  }
}

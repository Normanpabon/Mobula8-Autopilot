"""
ELRS Backend WebSocket Server
==============================
FastAPI + WebSocket para streaming de telemetría en tiempo real.

Uso:
    pip install fastapi uvicorn websockets
    python elrs_backend.py --port COM6 --baud 115200

Endpoints:
    WS  /ws              → WebSocket telemetría en tiempo real
    GET /api/status      → Estado del sistema
    GET /api/history     → Últimos N registros de telemetría
    GET /*               → Static files (React UI)
"""

import asyncio
import json
import sys
import argparse
from datetime import datetime, timezone
from pathlib import Path
from collections import deque
from dataclasses import dataclass, asdict
from typing import Optional, List

import serial
import struct
from fastapi import FastAPI, WebSocket, WebSocketDisconnect
from fastapi.staticfiles import StaticFiles
from fastapi.responses import FileResponse, JSONResponse
from fastapi.middleware.cors import CORSMiddleware
import uvicorn

# ─── Importar parsers del script original ───
CRSF_SYNC = 0xEA

@dataclass
class TelemetryFrame:
    """Frame de telemetría unificado para WebSocket"""
    type: str
    timestamp: str
    data: dict

class ConnectionManager:
    """Maneja múltiples conexiones WebSocket simultáneas"""
    def __init__(self):
        self.active_connections: List[WebSocket] = []

    async def connect(self, websocket: WebSocket):
        await websocket.accept()
        self.active_connections.append(websocket)
        print(f"[WS] Cliente conectado. Total: {len(self.active_connections)}")

    def disconnect(self, websocket: WebSocket):
        self.active_connections.remove(websocket)
        print(f"[WS] Cliente desconectado. Total: {len(self.active_connections)}")

    async def broadcast(self, message: dict):
        """Envía mensaje a todos los clientes conectados"""
        if not self.active_connections:
            return
        
        json_msg = json.dumps(message)
        disconnected = []
        
        for connection in self.active_connections:
            try:
                await connection.send_text(json_msg)
            except Exception as e:
                print(f"[WS] Error enviando a cliente: {e}")
                disconnected.append(connection)
        
        # Limpiar conexiones muertas
        for conn in disconnected:
            if conn in self.active_connections:
                self.active_connections.remove(conn)

# ─── Globals ───
app = FastAPI(title="ELRS Telemetry Server", version="1.0.0")
manager = ConnectionManager()
telemetry_history = deque(maxlen=1000)  # Últimos 1000 frames
system_status = {
    "serial_port": None,
    "baud_rate": None,
    "connected": False,
    "frames_received": 0,
    "uptime_seconds": 0,
    "start_time": None
}

# ─── CORS para desarrollo ───
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# ─── CRSF Parser (simplificado del script original) ───
def crc8_dvb_s2(data: bytes) -> int:
    crc_table = [0]*256
    for i in range(256):
        c = i
        for _ in range(8):
            c = ((c<<1)^0xD5)&0xFF if (c&0x80) else (c<<1)&0xFF
        crc_table[i] = c
    
    crc = 0
    for b in data:
        crc = crc_table[crc ^ b]
    return crc

def parse_crsf_frame(raw: bytes) -> Optional[dict]:
    """Parsea frame CRSF y retorna dict con tipo y datos"""
    if len(raw) < 4:
        return None
    
    ftype = raw[2]
    payload = raw[3:-1]
    
    # Verificar CRC
    if crc8_dvb_s2(raw[2:-1]) != raw[-1]:
        return None
    
    # Link Stats (0x14)
    if ftype == 0x14 and len(payload) >= 10:
        return {
            "type": "link",
            "data": {
                "rssi1": struct.unpack('b', bytes([payload[0]]))[0],
                "rssi2": struct.unpack('b', bytes([payload[1]]))[0],
                "lq": payload[2],
                "snr": struct.unpack('b', bytes([payload[3]]))[0],
                "active_antenna": payload[4],
                "rf_mode": payload[5],
                "tx_power": payload[6],
                "uplink_rssi": struct.unpack('b', bytes([payload[7]]))[0],
                "uplink_lq": payload[8],
                "uplink_snr": struct.unpack('b', bytes([payload[9]]))[0]
            }
        }
    
    # Battery (0x08)
    if ftype == 0x08 and len(payload) >= 8:
        return {
            "type": "battery",
            "data": {
                "voltage": struct.unpack('>H', payload[0:2])[0] / 10.0,
                "current": struct.unpack('>H', payload[2:4])[0] / 10.0,
                "mah_used": (struct.unpack('>I', payload[4:8])[0]) >> 8,
                "percent": payload[7]
            }
        }
    
    # Attitude (0x1E)
    if ftype == 0x1E and len(payload) >= 6:
        r2d = 180 / 3.14159265359
        return {
            "type": "attitude",
            "data": {
                "pitch": round(struct.unpack('>h', payload[0:2])[0] / 10000 * r2d, 2),
                "roll": round(struct.unpack('>h', payload[2:4])[0] / 10000 * r2d, 2),
                "yaw": round(struct.unpack('>h', payload[4:6])[0] / 10000 * r2d, 2)
            }
        }
    
    # Flight Mode (0x21)
    if ftype == 0x21:
        return {
            "type": "flight_mode",
            "data": {"mode": payload.rstrip(b'\x00').decode('ascii', 'ignore')}
        }
    
    return None

# ─── Serial Reader Task ───
async def serial_reader_task(port: str, baud: int):
    """Lee serial port y broadcast telemetría via WebSocket"""
    global system_status
    
    try:
        ser = serial.Serial(port, baud, timeout=0.1)
        system_status["connected"] = True
        system_status["serial_port"] = port
        system_status["baud_rate"] = baud
        print(f"[SERIAL] Conectado a {port} @ {baud} baud")
    except Exception as e:
        print(f"[SERIAL] Error abriendo puerto: {e}")
        system_status["connected"] = False
        return
    
    buf = bytearray()
    
    while True:
        try:
            # Leer datos del serial
            data = ser.read(128)
            if data:
                buf.extend(data)
            
            # Buscar frames CRSF
            while len(buf) >= 4:
                if buf[0] != CRSF_SYNC:
                    buf.pop(0)
                    continue
                
                frame_len = buf[1]
                total_len = frame_len + 2
                
                if len(buf) < total_len:
                    break
                
                frame = bytes(buf[:total_len])
                buf = buf[total_len:]
                
                # Parsear frame
                parsed = parse_crsf_frame(frame)
                if parsed:
                    # Agregar timestamp
                    frame_data = {
                        "timestamp": datetime.now(timezone.utc).isoformat(),
                        **parsed
                    }
                    
                    # Guardar en historial
                    telemetry_history.append(frame_data)
                    system_status["frames_received"] += 1
                    
                    # Broadcast a clientes WebSocket
                    await manager.broadcast(frame_data)
            
            # Yield control para otros tasks
            await asyncio.sleep(0.001)
            
        except Exception as e:
            print(f"[SERIAL] Error: {e}")
            await asyncio.sleep(1)

# ─── WebSocket Endpoint ───
@app.websocket("/ws")
async def websocket_endpoint(websocket: WebSocket):
    await manager.connect(websocket)
    try:
        while True:
            # Mantener conexión viva
            await websocket.receive_text()
    except WebSocketDisconnect:
        manager.disconnect(websocket)

# ─── REST API Endpoints ───
@app.get("/api/status")
async def get_status():
    """Estado del sistema y estadísticas"""
    if system_status["start_time"]:
        uptime = (datetime.now(timezone.utc) - system_status["start_time"]).total_seconds()
        system_status["uptime_seconds"] = int(uptime)
    
    return JSONResponse(system_status)

@app.get("/api/history")
async def get_history(limit: int = 100):
    """Últimos N frames de telemetría"""
    recent = list(telemetry_history)[-limit:]
    return JSONResponse({"frames": recent, "total": len(recent)})

@app.get("/api/latest")
async def get_latest():
    """Último frame de cada tipo"""
    latest = {}
    for frame in reversed(telemetry_history):
        ftype = frame["type"]
        if ftype not in latest:
            latest[ftype] = frame
        if len(latest) >= 4:  # link, battery, attitude, flight_mode
            break
    return JSONResponse(latest)

# ─── Static Files (Vanilla JS Frontend) ───
frontend_path = Path(__file__).parent / "frontend-vanilla"
if frontend_path.exists():
    # Serve static files (CSS, JS)
    static_path = frontend_path
    
    @app.get("/css/{file_path:path}")
    async def serve_css(file_path: str):
        """Serve CSS files"""
        css_file = frontend_path / "css" / file_path
        if css_file.exists():
            return FileResponse(css_file, media_type="text/css")
        return JSONResponse({"error": "CSS not found"}, status_code=404)
    
    @app.get("/js/{file_path:path}")
    async def serve_js(file_path: str):
        """Serve JS files"""
        js_file = frontend_path / "js" / file_path
        if js_file.exists():
            return FileResponse(js_file, media_type="application/javascript")
        return JSONResponse({"error": "JS not found"}, status_code=404)
    
    @app.get("/{full_path:path}")
    async def serve_react_app(full_path: str):
        """Serve index.html for all routes (except API/WS)"""
        if full_path.startswith("api/") or full_path.startswith("ws"):
            return JSONResponse({"error": "Not found"}, status_code=404)
        
        # Serve index.html
        index_file = frontend_path / "index.html"
        if index_file.exists():
            return FileResponse(index_file, media_type="text/html")
        return JSONResponse({"error": "Frontend not found"}, status_code=404)
else:
    @app.get("/")
    async def root():
        return JSONResponse({
            "message": "ELRS Telemetry Server",
            "status": "Frontend not found. Place frontend-vanilla/ folder next to this script.",
            "api_docs": "/docs"
        })

# ─── Startup ───
@app.on_event("startup")
async def startup_event():
    """Inicia serial reader al arrancar el servidor"""
    global system_status
    system_status["start_time"] = datetime.now(timezone.utc)
    
    # Obtener puerto y baud de argumentos CLI
    parser = argparse.ArgumentParser()
    parser.add_argument("--port", default="COM6")
    parser.add_argument("--baud", type=int, default=115200)
    args, _ = parser.parse_known_args()
    
    # Iniciar serial reader en background
    asyncio.create_task(serial_reader_task(args.port, args.baud))
    print(f"[SERVER] Iniciando con puerto {args.port} @ {args.baud} baud")

# ─── Main ───
if __name__ == "__main__":
    import sys
    
    # Parse args
    parser = argparse.ArgumentParser(description="ELRS Telemetry WebSocket Server")
    parser.add_argument("--port", default="COM6", help="Puerto serial")
    parser.add_argument("--baud", type=int, default=115200)
    parser.add_argument("--host", default="0.0.0.0", help="Host del servidor web")
    parser.add_argument("--web-port", type=int, default=8080, help="Puerto del servidor web")
    args = parser.parse_args()
    
    print("=" * 70)
    print("  ELRS Telemetry Server")
    print("=" * 70)
    print(f"  Serial:  {args.port} @ {args.baud} baud")
    print(f"  WebUI:   http://{args.host}:{args.web_port}")
    print(f"  WebSocket: ws://{args.host}:{args.web_port}/ws")
    print(f"  API Docs:  http://{args.host}:{args.web_port}/docs")
    print("=" * 70)
    
    # Correr servidor
    uvicorn.run(
        app,
        host=args.host,
        port=args.web_port,
        log_level="info"
    )
